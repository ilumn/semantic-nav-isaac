dev/turtlebot3/ros2_ws/frames_*.gv
dev/turtlebot3/ros2_ws/frames_*.pdf
/install/
/log/

# Isaac Sim runtime output (source scene and manifests stay tracked)
dev/isaac_sim/generated/
dev/isaac_sim/logs/
dev/isaac_sim/run/
dev/isaac_sim/cache/
dev/isaac_sim/*.pid
*.usd~
