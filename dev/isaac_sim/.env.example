# Copy to .env and update the installation path. This file is sourced by the
# host-facing scripts, so ordinary shell quoting is supported.

# Required native Isaac Sim 6.0.1 installation root. It must contain python.sh.
ISAAC_SIM_ROOT=/opt/isaac-sim

# Uncomment only after each user has read and accepted NVIDIA's Isaac Sim EULA.
# OMNI_KIT_ACCEPT_EULA=YES

# Port workspace and scene defaults. ISAAC_TOOL_DIR is defined before .env loads.
ISAAC_ROS_WS="${ISAAC_PORT_ROOT}/dev/turtlebot3/ros2_ws"
ISAAC_SEMANTIC_VENV="${ISAAC_PORT_ROOT}/.venv"
ISAAC_SCENE_SCRIPT="${ISAAC_TOOL_DIR}/scene/run_semantic_nav.py"

# Leave unset unless the scene runner should load/save a specific composed USD.
# ISAAC_STAGE_PATH="${ISAAC_TOOL_DIR}/generated/semantic_nav.usd"

# Set this to the workstation's active X display. Use ISAAC_HEADLESS=true on a
# machine without a display session.
DISPLAY=:0
ISAAC_HEADLESS=false

# Isaac and the external ROS stack must use the same domain and Fast DDS.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

ISAAC_SIM_VERSION_EXPECTED=6.0.1
ISAAC_SHUTDOWN_TIMEOUT=20

# Optional uncommon layouts/diagnostics:
# ISAAC_PYTHON=/absolute/path/to/isaac-sim/python.sh
# ISAAC_SIM_VERSION=6.0.1
# FASTRTPS_DEFAULT_PROFILES_FILE=/absolute/path/to/fastdds.xml
# ISAAC_ALLOW_UNVERIFIED_VERSION=false
# ISAAC_ALLOW_VERSION_MISMATCH=false
