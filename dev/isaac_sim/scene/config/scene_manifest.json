    "lidar_link": "base_scan",
    "camera_link": "camera_rgb_optical_frame",
    "max_linear_speed_mps": 0.26,
    "max_angular_speed_rps": 1.82
  },
  "sensors": {
    "lidar": {
      "name": "IsaacLidar",
      "config": "Example_Rotary_2D",
      "frame_id": "base_scan",
      "rate_hz": 20.0,
      "samples_per_scan": 360,
      "min_range_m": 0.12,
      "max_range_m": 3.5,
      "noise_stddev_m": 0.01
    },
    "camera": {
      "name": "IsaacCamera",
      "frame_id": "camera_rgb_optical_frame",
      "rate_hz": 60.0,
      "resolution": [640, 480],
      "horizontal_fov_rad": 1.085595,
      "clip_m": [0.03, 100.0],
      "noise_stddev": 0.007,
      "horizontal_aperture_mm": 36.0,
      "usd_camera_to_ros_optical_wxyz": [0.0, 1.0, 0.0, 0.0]
    },
    "imu": {
      "name": "IsaacImu",
      "frame_id": "imu_link",
      "rate_hz": 200.0,
      "linear_acceleration_filter_size": 1,
      "angular_velocity_filter_size": 1,
      "orientation_filter_size": 1,
      "read_gravity": true
    }
  },
  "ros2": {
    "domain_id_from_environment": true,
    "sensor_data_qos": {
      "history": "keepLast",
      "depth": 5,
      "reliability": "bestEffort",
      "durability": "volatile",
      "deadline": 0.0,
      "lifespan": 0.0,
      "liveliness": "systemDefault",
      "leaseDuration": 0.0
    },
    "topics": {
      "clock": "/clock",
      "cmd_vel": "/cmd_vel",
      "odom": "/odom",
      "joint_states": "/joint_states",
      "tf": "/tf",
      "scan": "/scan",
      "imu": "/imu",
      "camera_image": "/camera/image_raw",
      "camera_info": "/camera/camera_info"
    },
    "frames": {
      "odom": "odom",
      "base": "base_footprint"
    },
    "cmd_vel_message": "geometry_msgs/msg/Twist",
    "tf_ownership": {
      "isaac": ["odom->base_footprint"],
      "robot_state_publisher": ["base_footprint->base_link", "base_link->robot_links"],
      "slam_or_localization": ["map->odom"]
    }
