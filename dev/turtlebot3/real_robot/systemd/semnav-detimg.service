[Unit]
Description=semnav: compressed, size-capped copy of the detector image for remote viewers
PartOf=semnav.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/mnt/data/models
ExecStart=/bin/bash -c 'source /mnt/data/semnav/env.sh && exec python3 /mnt/data/semnav/debug_jpeg.py'

KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
Restart=always
RestartSec=3
SyslogIdentifier=semnav-detimg
