[Unit]
Description=semnav: Foxglove bridge on the Tailscale address only (port 8765)
PartOf=semnav.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/mnt/data/models
ExecStart=/bin/bash -c 'source /mnt/data/semnav/env.sh && exec ros2 run foxglove_bridge foxglove_bridge --ros-args --params-file /mnt/data/semnav/foxglove.yaml -p address:=$$(tailscale ip -4)'
# Tailscale may not be up yet at boot; the unit just retries until it is.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
Restart=always
RestartSec=3
SyslogIdentifier=semnav-foxglove
