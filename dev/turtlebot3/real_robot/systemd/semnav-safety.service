[Unit]
Description=semnav: safety gate between /cmd_vel and the motors (/cmd_vel_safe)
PartOf=semnav.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/mnt/data/models
ExecStart=/bin/bash -c 'source /mnt/data/semnav/env.sh && exec python3 /mnt/data/semnav/semnav_safety.py'
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=10
Restart=always
RestartSec=1
SyslogIdentifier=semnav-safety
