[Unit]
Description=semnav: LDS-02 scan normalizer (/scan -> fixed 360-ray /scan_slam)
PartOf=semnav.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/mnt/data/models
ExecStart=/bin/bash -c 'source /mnt/data/semnav/env.sh && exec python3 /mnt/data/semnav/scan_normalizer/scan_normalizer_node.py --ros-args -p target_count:=360'

KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
Restart=always
RestartSec=3
SyslogIdentifier=semnav-scan
