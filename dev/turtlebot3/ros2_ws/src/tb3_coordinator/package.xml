<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_coordinator</name>
  <version>0.1.0</version>
  <description>
    Lightweight coordinator for TurtleBot3 semantic navigation.
    Manages mode switching between frontier exploration and semantic
    target navigation.
  </description>
  <maintainer email="user@todo.todo">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tb3_query</depend>
  <depend>tb3_frontier_exploration</depend>
  <depend>tb3_semantic_map_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- semantic_nav_stack.launch.py resolves these packages eagerly, even when
       an individual component is disabled by a launch condition. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>tb3_detector</exec_depend>
  <exec_depend>tb3_localizer</exec_depend>
  <exec_depend>tb3_memory</exec_depend>
  <exec_depend>tb3_nav_adapter</exec_depend>
  <exec_depend>tb3_semantic_map</exec_depend>
  <exec_depend>tb3_semantic_refiner</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
